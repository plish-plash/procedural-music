{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Procedural Music",
  "version": "0.1.0",
  "identifier": "dev.proceduralmusic.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
